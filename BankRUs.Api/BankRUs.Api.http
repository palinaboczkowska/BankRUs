@BankRUs.Api_HostAddress = https://localhost:8000

### Öppna konto
POST https://localhost:8000/api/accounts
Content-Type: application/json
{
  "firstName": "Rolly",
  "lastName": "Doe",
  "socialSecurityNumber": "189001239806",
  "email": "rolly@doe.com"
}


### Öppna bankkonto
POST https://localhost:8000/api/bank-accounts
Content-Type: application/json
{
  "userId": "0142dcf7-494c-4bab-8d94-21f95a40d346",
  "name": "Semesterkonto"
}


### Hämta alla konton för en användare
GET https://localhost:8000/api/accounts/0142dcf7-494c-4bab-8d94-21f95a40d346

### Logga in / Autentisera
POST https://localhost:8000/api/auth/login
Content-Type: application/json
{
  "username": "polly@doe.com",
  "password": "Secret#1"
}


### Hämta kontouppgifter
GET https://localhost:8000/api/me
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..x2cRN5TsZA_G34_thtEZK3OK_Rx0vxtjFxMBQzBKkRA



### Login as CustomerService
POST https://localhost:8000/api/auth/login
Content-Type: application/json
{
  "username": "service@test.com",
  "password": "Secret#1"
}


### Get customers
GET https://localhost:8000/api/customers?page=1&pageSize=10
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..GdTIkLaTVG-4OR5-AD3WQtCcNcU0DElggPuPyCNY7HM

### Get customer by id
GET https://localhost:8000/api/customers/0142dcf7-494c-4bab-8d94-21f95a40d346
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..f1t56hQxBWMrMs5ymfBoDylord-5r7CoNB0WMK7_9uQ


### Search customers by SSN
GET https://localhost:8000/api/customers?ssn=19010101&page=1&pageSize=10
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..hHdDU73oRsFRkF-5pej0vuhfUCvr3SaVeaVywRJs0hk


### Login as Customer
POST https://localhost:8000/api/auth/login
Content-Type: application/json

{
  "username": "polly@doe.com",
  "password": "Secret#1"
}

### Update my account details
PATCH https://localhost:8000/api/me
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..x2cRN5TsZA_G34_thtEZK3OK_Rx0vxtjFxMBQzBKkRA

{
  "firstName": "PollyUpdated",
  "lastName": "DoeUpdated",
  "email": "polly.updated@doe.com",
  "socialSecurityNumber": "189001079999"
}

